# ==========================================
# Medical RAG Assistant - Environment Config
# ==========================================

# DeepSeek LLM API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Flask
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Chroma Vector Store
CHROMA_DIR=./backend/data/chroma

# Data
PROCESSED_DATA_DIR=./backend/data/processed
RAW_DATA_DIR=E:/ProgramData/DataSet
